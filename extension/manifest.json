{
  "manifest_version": 3,
  "name": "FlexiProxy Monitor",
  "version": "1.0.0",
  "description": "Real-time monitoring dashboard for FlexiProxy.",
  "permissions": [],
  "host_permissions": [
    "http://localhost:8081/*",
    "http://127.0.0.1:8081/*"
